{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@ip/contracts": [
        "../contracts/src/index.ts"
      ],
      "@ip/domain": [
        "../domain/src/index.ts"
      ],
      "@ip/domain/*": [
        "../domain/src/*"
      ],
      "@ip/domain/types": [
        "../domain/src/types/index.ts"
      ],
      "@ip/app-state": [
        "./src/index.ts"
      ],
      "@ip/app-state/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../../src/*"
      ],
      "@ip/ui": [
        "../ui/src/index.ts"
      ],
      "@ip/ui/*": [
        "../ui/src/*"
      ],
      "@ip/api": [
        "../api/src/index.ts"
      ],
      "@ip/api/*": [
        "../api/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
