# Large training blobs — never commit weights/checkpoint binaries
*.pt
*.bin
*.safetensors
*.ckpt
*.onnx
*.gguf

# Local data overrides (AI Data deliverable lands under docs/ai-data/mvp-sft/)
# Synthetic stub JSONL generated by the runner is local-only
data/*.jsonl
!data/.gitkeep

# Scratch
__pycache__/
*.pyc
.runs/
